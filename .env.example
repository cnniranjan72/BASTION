# Copy to .env and adjust as needed. Loaded by interceptor/ and aggregator/.

NODE_ENV=development

DATABASE_URL=postgres://bastion:bastion@localhost:5442/bastion
REDIS_URL=redis://localhost:6389

INTERCEPTOR_PORT=4001
AGGREGATOR_PORT=4002

# Phase 5 (auth) — Ed25519 keypair for signing JWT access tokens.
# Generate with: uv run python infra/keys/generate_dev_keys.py
# (defaults below already point there; only set these to use a different pair)
# JWT_PRIVATE_KEY_PATH=./infra/keys/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=./infra/keys/jwt_public.pem
# APPROVAL_TTL_SECONDS=300
# APPROVAL_LONG_POLL_SECONDS=25
# REFRESH_TOKEN_TTL_DAYS=30

# Phase 9 (deployment) — managed Postgres for the deployed/staging environment.
# Local dev and the test suite use DATABASE_URL above (Docker Compose), not this.
# NEON_DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Phase 9 (deployment) — Render CLI/API auth.
# RENDER_API_KEY=

# U17 (BYOK — ADR-022) — required to store or use LLM provider credentials
# (POST /llm-keys, POST /demo/live-run). 32 random bytes, base64-encoded.
# Generate with: uv run python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Simple, single-key setup — implicitly "key version 1". Fine for local
# dev/most deployments; use the versioned pair below only when rotating.
# BYOK_MASTER_KEY=

# U17 — versioned alternative to BYOK_MASTER_KEY above, needed only when
# rotating: a JSON map of version -> base64 key, plus which version is
# current. Existing rows keep decrypting under their own recorded version
# as long as it's still present here — run
# infra/scripts/rotate_byok_master_key.py to re-encrypt every row onto the
# new current version, then drop the old one from the map.
# BYOK_MASTER_KEYS={"1": "<old key>", "2": "<new key>"}
# BYOK_MASTER_KEY_VERSION=2

# U17 — optional local LLM backend for demo-agent's --llm ollama flag and
# the frontend's "run with local Ollama" option. Defaults assume
# `ollama serve` running locally with a tool-calling-capable model pulled
# (e.g. `ollama pull llama3.1`).
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL_OLLAMA=llama3.1
# Local CPU/GPU inference is much slower than a cloud API, especially on
# a cold model load — found by actually running this against a real
# local Ollama instance. Default 180s; raise if your machine is slower.
# OLLAMA_TIMEOUT_SECONDS=180
