# Copy to .env and adjust as needed. Loaded by interceptor/ and aggregator/.

NODE_ENV=development

DATABASE_URL=postgres://bastion:bastion@localhost:5442/bastion
REDIS_URL=redis://localhost:6379

INTERCEPTOR_PORT=4001
AGGREGATOR_PORT=4002

# Phase 5 (auth) — Ed25519 keypair for signing JWT access tokens.
# Generate with: uv run python infra/keys/generate_dev_keys.py
# (defaults below already point there; only set these to use a different pair)
# JWT_PRIVATE_KEY_PATH=./infra/keys/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=./infra/keys/jwt_public.pem
# APPROVAL_TTL_SECONDS=300
# APPROVAL_LONG_POLL_SECONDS=25
# REFRESH_TOKEN_TTL_DAYS=30

# Phase 9 (deployment) — managed Postgres for the deployed/staging environment.
# Local dev and the test suite use DATABASE_URL above (Docker Compose), not this.
# NEON_DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Phase 9 (deployment) — Render CLI/API auth.
# RENDER_API_KEY=
