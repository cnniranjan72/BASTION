# Copy to .env and adjust as needed. Loaded by interceptor/ and aggregator/.

NODE_ENV=development

DATABASE_URL=postgres://bastion:bastion@localhost:5442/bastion
REDIS_URL=redis://localhost:6379

INTERCEPTOR_PORT=4001
AGGREGATOR_PORT=4002

# Phase 5 (auth) — asymmetric keypair for signing JWT access tokens.
# Generate with: openssl genpkey -algorithm ed25519 -out jwt_private.pem
# JWT_PRIVATE_KEY_PATH=./infra/keys/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=./infra/keys/jwt_public.pem
